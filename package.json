{
  "name": "multi-platform-publisher",
  "version": "0.11.0-rc.1",
  "private": true,
  "description": "多平台内容发布工具 — 一份内容自动适配公众号/知乎/B站/小红书并一键发布(默认模拟)",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/app",
    "packages/server",
    "packages/runner",
    "packages/desktop"
  ],
  "scripts": {
    "build:core": "npm run build -w @mpp/core",
    "dev": "npm run dev -w @mpp/app",
    "build:web": "npm run build -w @mpp/app",
    "build:ext": "npm run build:ext -w @mpp/app",
    "build:server": "npm run build -w @mpp/server",
    "build:runner": "npm run build -w @mpp/runner",
    "server": "npm run build:core && npm run dev -w @mpp/server",
    "runner": "npm run dev -w @mpp/runner",
    "desktop": "npm run dev -w @mpp/desktop",
    "desktop:build": "npm run build -w @mpp/desktop",
    "desktop:icon": "npm run icon -w @mpp/desktop",
    "demo": "node scripts/demo.mjs",
    "demo:ai": "node scripts/demo-ai-enhance.mjs",
    "test": "vitest run",
    "canary": "node scripts/canary.mjs --platform all",
    "canary:check": "node scripts/canary.mjs --check",
    "canary:real": "node scripts/canary.mjs --platform all --real",
    "drill:upgrade-rollback": "node scripts/upgrade-rollback-drill.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude \"**/web-e2e.spec.ts\" --exclude \"**/platform-fixtures.spec.ts\"",
    "test:e2e": "vitest run packages/runner/test/platform-fixtures.spec.ts packages/app/test/web-e2e.spec.ts",
    "check:browser-fixture": "node scripts/check-browser-fixture.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:sums": "node scripts/release-gate.mjs --sums",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build:core && npm run build:web && npm run build:server && npm run build:runner && npm run build:ext && npm run check:bundle",
    "prepare": "simple-git-hooks",
    "check:bundle": "npm run build:web && node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "lint-staged": "^15.3.0",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "engines": {
    "node": ">=20"
  }
}