# ─────────────────────────────────────────────────────────────
# 公众号官方 API 凭据(真实发布时需要;默认不配置则仅健康检查+模拟)。
# 安全:本文件被 .gitignore 排除,密钥绝不入库,绝不暴露给前端/扩展。
# ─────────────────────────────────────────────────────────────
WECHAT_APPID=
WECHAT_SECRET=

# server 监听端口(默认 8787,仅 localhost)。
PORT=8787

# 日志级别(trace/debug/info/warn/error)。
LOG_LEVEL=info

# 限流:每分钟每 IP 最大请求数(默认 120)。
RATE_LIMIT_MAX=120

# ─────────────────────────────────────────────────────────────
# 图床配置:决定本地图片/封面上传到哪里。
#   local  = 落盘 + 静态服务(零配置兜底;部署公网即真图床)
#   s3     = S3 兼容对象存储(Cloudflare R2 / 阿里云 OSS / MinIO)
# ─────────────────────────────────────────────────────────────
IMAGE_HOST=local

# local 图床:落盘目录(相对 server 包根)与公开访问基址。
# 部署到公网时把 IMAGE_LOCAL_BASE_URL 改为对外域名(如 https://cdn.example.com)。
IMAGE_LOCAL_DIR=data/uploads
IMAGE_LOCAL_BASE_URL=http://127.0.0.1:8787

# S3 兼容对象存储(IMAGE_HOST=s3 时需全部填写)。
# 示例(Cloudflare R2):
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=my-bucket
#   S3_PUBLIC_BASE_URL=https://cdn.example.com   (bucket 的公开访问域名)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────────
# 本机特权服务鉴权(SEC-01)
# 启动时自动生成高熵 token;客户端需在请求头 X-MPP-Token 携带。
# 测试可显式指定;生产请留空让每次启动随机生成。
# MP_SERVER_TOKEN=
# 仅在测试/无副作用场景关闭鉴权:
# MP_AUTH_DISABLED=false

# ─────────────────────────────────────────────────────────────
# 数据目录(任务持久化等落盘位置,相对 server 包根,默认 data)
# MP_DATA_DIR=data


# ─────────────────────────────────────────────────────────────
# 远程图片抓取安全限制(SEC-02,SSRF / 资源耗尽边界)
# IMAGE_FETCH_TIMEOUT_MS=10000
# IMAGE_FETCH_MAX_BYTES=10485760
# IMAGE_FETCH_MAX_REDIRECTS=3
# IMAGE_FETCH_ALLOWED_MIME=image/png,image/jpeg,image/gif,image/webp

# ─────────────────────────────────────────────────────────────
# local 图床配额与保留(SEC-05)
# IMAGE_STORE_MAX_TOTAL_BYTES=209715200
# IMAGE_STORE_MAX_FILE_BYTES=10485760
# IMAGE_STORE_RETENTION_MS=604800000
# IMAGE_STORE_CLEANUP_DISABLED=false

# ─────────────────────────────────────────────────────────────
# 周报投递(WEEKLY-03,凭据只在 server 环境变量,不落盘/不暴露前端)
# 邮件:配置后周报可投递到邮箱(未配置则邮件渠道明确提示不可用)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_USER=bot@example.com
# MAIL_PASS=
# MAIL_FROM=bot@example.com
# Webhook:只允许投递到白名单主机(逗号分隔),防止周报误发任意 URL
# WEEKLY_WEBHOOK_HOSTS=hooks.slack.com,oapi.dingtalk.com

# ─────────────────────────────────────────────────────────────
# v4 Phase 3 · 协作共享(COLLAB-04,可选远程同步)
# 自托管同步服务器地址(与本地 server 同协议;为空 = 纯本地/局域网共享)
# 设置后 /share 列表会声明 sync 字段,客户端可感知同步源
# SYNC_URL=http://192.168.1.10:8787
